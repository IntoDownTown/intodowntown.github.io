{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" },
    "suffixe": { "type": "string" }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('law-bicep-{0}', parameters('suffixe'))]",
      "location": "[parameters('location')]",
      "properties": { "retentionInDays": 30, "sku": { "name": "PerGB2018" } }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[format('kvbicep{0}', parameters('suffixe'))]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": { "family": "A", "name": "standard" },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true
      }
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', format('kvbicep{0}', parameters('suffixe')))]",
      "name": "kv-vers-law",
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('law-bicep-{0}', parameters('suffixe')))]",
        "logAnalyticsDestinationType": "Dedicated",
        "logs": [{ "categoryGroup": "audit", "enabled": true }]
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', format('kvbicep{0}', parameters('suffixe')))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('law-bicep-{0}', parameters('suffixe')))]"
      ]
    }
  ],
  "outputs": {
    "vaultName": { "type": "string", "value": "[format('kvbicep{0}', parameters('suffixe'))]" }
  }
}
